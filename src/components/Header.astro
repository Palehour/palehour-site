---
import Mark from './Mark.astro';
import type { Copy } from '../i18n/es';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="site-header">
  <a class="brand" href="#inicio" aria-label={copy.a11y.home}>
    <Mark width={34} />
    <span class="brand-word" aria-hidden="true">Palehour</span>
  </a>

  <nav class="nav" aria-label={copy.a11y.nav}>
    <ul class="nav-links">
      {copy.nav.map((item) => (
        <li><a class="line-link" href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <span class="divider" aria-hidden="true"></span>
    <ul class="lang" aria-label={copy.a11y.language}>
      <li><a href={base} lang="es" aria-current="page">ES</a></li>
      <li>
        <span class="lang-off" lang="en" aria-disabled="true" title="English — coming soon">
          EN<span class="sr-only"> ({copy.a11y.soon})</span>
        </span>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    padding: var(--sp-6) var(--sp-7);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: var(--tap);
    color: var(--ph-pale);
  }
  .brand-word {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 0.48em;
    text-transform: uppercase;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
  }
  .nav-links { gap: 36px; }
  .nav-links a,
  .lang a,
  .lang-off {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ph-fog-200);
  }
  .divider {
    width: 1px;
    height: 16px;
    background: var(--ph-fog-700);
  }
  .lang { gap: var(--sp-3); }
  .lang a { color: var(--ph-glow); padding-inline: 4px; }
  .lang-off { color: var(--ph-fog-400); cursor: default; padding-inline: 4px; }

  /* Móvil: la nav pasa a una segunda fila compacta, sin menú desplegable ni JS */
  @media (max-width: 760px) {
    .site-header { padding: var(--sp-4) var(--sp-5); }
    .brand-word { font-size: 13px; letter-spacing: 0.44em; }
    .nav {
      width: 100%;
      justify-content: space-between;
      gap: var(--sp-4);
    }
    .nav-links { gap: var(--sp-5); }
    .nav-links a, .lang a, .lang-off { font-size: 11px; letter-spacing: 0.2em; }
    .divider { display: none; }
  }
  @media (max-width: 360px) {
    .nav-links { gap: var(--sp-4); }
    .nav-links a, .lang a, .lang-off { letter-spacing: 0.14em; }
  }
</style>
