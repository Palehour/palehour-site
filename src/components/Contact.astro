---
import SectionHeader from './SectionHeader.astro';
import type { Copy } from '../i18n/es';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const t = copy.contact;
---
<section id="contacto" class="section" aria-labelledby="t-contacto">
  <div class="container grid">
    <div class="head">
      <SectionHeader id="t-contacto" numeral={t.numeral} eyebrow={t.eyebrow} title={t.title} />
      <a class="email line-link" href={`mailto:${t.email}`}>{t.email}</a>
    </div>

    <ul class="links">
      {t.links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="label">{link.label}</span>
            <span class="value">{link.value}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M1 11L11 1M4 1h7v7"></path>
            </svg>
            <span class="sr-only">{copy.a11y.newTab}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y) clamp(80px, 8vw, 128px);
    border-top: 1px solid var(--ph-fog-900);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: var(--sp-8) var(--sp-9);
    align-items: end;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    min-width: 0;
  }
  .email {
    align-self: flex-start;
    max-width: 100%;
    padding-bottom: 4px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-link-xl);
    line-height: 1.3;
    color: var(--ph-glow);
    overflow-wrap: anywhere;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ph-fog-900);
  }
  .links li { border-bottom: 1px solid var(--ph-fog-900); }
  .links a {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    min-height: 72px;
    color: var(--ph-fog-400);
    transition: color var(--dur-1) var(--ease-mist);
  }
  .links .label { width: 96px; flex: none; }
  .links .value {
    flex: 1;
    color: var(--ph-pale);
    transition: color var(--dur-1) var(--ease-mist);
  }
  .links a:hover,
  .links a:focus-visible { color: var(--ph-glow); }
  .links a:hover .value,
  .links a:focus-visible .value { color: var(--ph-glow); }

  @media (max-width: 560px) {
    .links a { min-height: 64px; gap: var(--sp-4); }
    .links .label { width: 72px; }
  }
</style>
