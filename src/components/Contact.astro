---
// Contacto mínimo al pie. Textos en español; al sumar inglés, mover a src/i18n.
const email = 'palehourstudios@gmail.com';
const links = [
  { label: 'Email', value: email, href: `mailto:${email}` },
  { label: 'X', value: '@palehour', href: 'https://x.com/palehour', external: true },
  { label: 'GitHub', value: 'github.com/Palehour', href: 'https://github.com/Palehour', external: true },
];
---
<footer class="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="contact-title">Contacto</h2>
  <ul class="contact-list">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="contact-label">{link.label}</span>
          <span class="contact-value">{link.value}</span>
          {link.external && <span class="sr-only">(se abre en una pestaña nueva)</span>}
        </a>
      </li>
    ))}
  </ul>
  <p class="contact-copy">© {new Date().getFullYear()} Palehour</p>
</footer>

<style>
  .contact {
    border-top: 1px solid #15171a;
    padding: clamp(5rem, 12vw, 9rem) clamp(1.5rem, 5vw, 3rem) clamp(3rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }
  .contact-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    letter-spacing: 0.5em;
    padding-left: 0.5em;
    text-transform: uppercase;
    color: #e6e9ec;
  }
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem clamp(2.5rem, 7vw, 5rem);
  }
  .contact-list a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.25rem;
    color: #c3c8ce;
    text-decoration: none;
    transition: color 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .contact-label {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.32em;
    padding-left: 0.32em;
    text-transform: uppercase;
    color: #8b929a;
  }
  .contact-value {
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
    overflow-wrap: anywhere;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .contact-list a:hover,
  .contact-list a:focus-visible {
    color: #f4f6f8;
  }
  .contact-list a:hover .contact-value,
  .contact-list a:focus-visible .contact-value {
    background-size: 100% 1px;
  }
  .contact-list a:focus-visible {
    outline: 1px solid #9fb3c8;
    outline-offset: 6px;
    border-radius: 2px;
  }
  .contact-copy {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    color: #8b929a;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 560px) {
    .contact-list {
      flex-direction: column;
      align-items: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-list a,
    .contact-value {
      transition: none;
    }
  }
</style>
