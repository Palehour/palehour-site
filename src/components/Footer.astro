---
import Mark from './Mark.astro';
import type { Copy } from '../i18n/es';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container row">
    <p class="copy">
      <Mark width={28} color="var(--ph-fog-400)" />
      <span>© {year} Palehour</span>
    </p>
    <a class="line-link top" href="#inicio">{copy.footer.backToTop}</a>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--ph-fog-900); }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding-block: 40px;
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ph-fog-400);
  }
  .copy {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .top {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
