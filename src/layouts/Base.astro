---
import '../styles/global.css';
import type { Copy } from '../i18n/es';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og-image.png`, Astro.site).href;
---
<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href={`${base}favicon.jpg`} />
    <link rel="apple-touch-icon" href={`${base}palehour-logo.jpg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Palehour" />
    <meta property="og:locale" content={copy.locale} />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={copy.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@palehour" />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={copy.meta.ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Hanken+Grotesk:wght@300;400&display=swap"
    />

    <!--
      Decide la intro antes de pintar, para evitar parpadeos.
      Se ve una vez por sesión; con "reducir movimiento" o sin JS, el inicio
      arranca directamente en el estado final.
    -->
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var seen = sessionStorage.getItem('ph-intro-seen') === '1';
          if (!reduce && !seen) {
            var root = document.documentElement;
            root.classList.add('intro');
            // Red de seguridad: si el script del hero no corre, mostrar el sitio igual.
            setTimeout(function () {
              if (root.classList.contains('intro')) {
                root.classList.remove('intro');
                root.classList.add('intro-out');
              }
            }, 16000);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{copy.a11y.skip}</a>
    <slot />
  </body>
</html>
